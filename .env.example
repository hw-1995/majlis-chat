# Leave everything unset to use the built-in mock provider (no API key needed).
#
# To point at a real backend, set the URL of an endpoint that accepts
# POST { messages: Message[] } and replies with an SSE stream of
#   data: {"type":"token","value":"..."}
#   data: {"type":"done"}
# VITE_API_URL=http://localhost:8787/api/chat
